# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# App Configuration
VITE_APP_NAME=InsureAI Dashboard
VITE_APP_DESCRIPTION=AI-Powered Insurance Dashboard

# Client Configuration (for multi-tenant setup)
VITE_CLIENT_ID=default
VITE_CLIENT_THEME=default
VITE_ACCENT_COLOR=0.546 0.245 262.881

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_OUTREACH_MODAL=false
VITE_CHATBOT_MODAL=false
